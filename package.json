{
  "name": "choicemymodel",
  "version": "0.1.0",
  "description": "Jev-style model router: a cheap, typed classifier that picks the right Claude model tier per task.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "choicemymodel": "./dist/cli.js"
  },
  "scripts": {
    "prepare": "node -e \"require('node:fs').existsSync('.git') && require('node:child_process').execSync('git config core.hooksPath .githooks')\"",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts",
    "eval": "tsx --env-file-if-exists=.env src/evals/run.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
