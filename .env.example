# Jev classifier (default backend) — read by @typesafe-ai/sdk
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
# error | warn | info | debug
TYPESAFE_LOG_LEVEL=warn

# claude | codex — overrides Jev's own vendor pick (vendorFit) when set.
# Leave unset to let Jev decide the vendor per task.
HERD_KIND=

PORT=8787
