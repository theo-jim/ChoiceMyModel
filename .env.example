# Jev classifier (default backend)
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# This project's own setting, not a TypeSafe SDK variable
TYPESAFE_TIMEOUT_MS=10000

# Comparison backend, used when CLASSIFIER=claude
ANTHROPIC_API_KEY=

# jev | claude
CLASSIFIER=jev

PORT=8787
